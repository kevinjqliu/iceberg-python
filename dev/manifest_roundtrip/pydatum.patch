--- a/bindings/python/tests/test_manifest.py
+++ b/bindings/python/tests/test_manifest.py
@@ -15,6 +15,7 @@
 # specific language governing permissions and limitations
 # under the License.
 
+from pathlib import Path
 from typing import Any
 
 import pytest
@@ -171,3 +172,47 @@ def test_read_manifest_entry(generated_manifest_entry_file: str) -> None:
     assert data_file.split_offsets == [4]
     assert data_file.equality_ids is None
     assert data_file.sort_order_id == 0
+
+
+def test_partition_values_are_typed(tmp_path: Path) -> None:
+    """Partition values carry their Iceberg type: decimals keep their scale."""
+    from decimal import Decimal
+
+    from pyiceberg.io.pyarrow import PyArrowFileIO
+    from pyiceberg.manifest import write_manifest
+    from pyiceberg.partitioning import PartitionField, PartitionSpec
+    from pyiceberg.schema import Schema
+    from pyiceberg.transforms import IdentityTransform
+    from pyiceberg.typedef import Record
+    from pyiceberg.types import DecimalType, IntegerType, NestedField
+
+    schema = Schema(
+        NestedField(1, "d", DecimalType(9, 2), required=False),
+        NestedField(2, "i", IntegerType(), required=False),
+        schema_id=0,
+    )
+    spec = PartitionSpec(
+        PartitionField(1, 1000, IdentityTransform(), "d"),
+        PartitionField(2, 1001, IdentityTransform(), "i"),
+        spec_id=0,
+    )
+    data_file = DataFile.from_args(
+        content=DataFileContent.DATA,
+        file_path="s3://bucket/file.parquet",
+        file_format=FileFormat.PARQUET,
+        partition=Record(Decimal("0.10"), None),
+        record_count=1,
+        file_size_in_bytes=1,
+    )
+    entry = ManifestEntry.from_args(status=ManifestEntryStatus.ADDED, snapshot_id=1, data_file=data_file)
+    path = str(tmp_path / "manifest.avro")
+    with write_manifest(2, spec, schema, PyArrowFileIO().new_output(path), 1, "deflate") as writer:
+        writer.add_entry(entry)
+
+    read_file = manifest.read_manifest_entries(Path(path).read_bytes()).entries()[0].data_file
+    assert read_file.partition_types == ["decimal(9, 2)", "int"]
+    decimal_value, null_value = read_file.partition
+    assert null_value is None
+    assert decimal_value.type == "decimal(9, 2)"
+    assert decimal_value.value() == Decimal("0.10")
+    assert decimal_value.value().as_tuple().exponent == -2
